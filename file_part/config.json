{
    "app_name":"iland Pro",
    "version":"2.0.1",
    "database":{
        "host":"localhost",
        "port":5432,
        "username":"admin",
        "password":"$dsmi#",
        "database":["user_db","product_db","logs_db"],
        "pool_size":10,
        "timeout":30
    },
    "api_settings":{
        "base_url":"https//Lssc.ir/v2",
        "endpoint":{
            "users":"/users",
            "products":"/products",
            "logs":"/logs",
            "orders":"/orders"
        },
        "rate_limit":100,
        "retry_attempts":3
    },
    "logging":{
        "level":"INFO",
        "format":"%(asctime)s-%(name)s-%(levelname)s-%(message)s",
        "file_size_mb":50,
        "backup_count":5
    },
    "features":{
        "dark_mode":true,
        "notifications":true,
        "auto_save":false,
        "languages":["en","fa","ch","ar"]
    }
}